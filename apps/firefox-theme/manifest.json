{
  "manifest_version": 3,
  "name": "AeroFox — Frutiger Aero for Firefox",
  "short_name": "AeroFox",
  "version": "0.1.0",
  "description": "Reskins Firefox's own browser chrome and New Tab page in Frutiger Aero — Vista Glass, Frutiger Eco, Dark Aero, Royale Noir, and Media Center — using Firefox's native theme API, with a live switcher. 100% original gradients, no copied OS assets, no external page content touched.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aerofox@frutiger-aero-lab",
      "strict_min_version": "112.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["theme", "storage"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AeroFox",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
